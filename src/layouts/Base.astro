---
import '../styles/global.css';
import sansFont from '@fontsource-variable/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-wght-normal.woff2?url';
import monoFont from '@fontsource-variable/atkinson-hyperlegible-mono/files/atkinson-hyperlegible-mono-latin-wght-normal.woff2?url';
import { person } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  /** Set on pages that should not be indexed (e.g. 404). */
  noindex?: boolean;
}

const {
  title = `${person.name} · QA Engineer, healthcare focus`,
  description = 'QA Engineer with 6+ years across healthcare IT, regulated gaming and enterprise web and mobile applications. HL7 and FHIR knowledge, C# and Java test automation, AI-assisted testing.',
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://lisnathomas.github.io');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og.png', site).href;

const fontFaces = `
@font-face {
  font-family: 'Atkinson Hyperlegible Next';
  font-style: normal;
  font-display: swap;
  font-weight: 200 800;
  src: url(${sansFont}) format('woff2');
}
@font-face {
  font-family: 'Atkinson Hyperlegible Mono';
  font-style: normal;
  font-display: swap;
  font-weight: 200 800;
  src: url(${monoFont}) format('woff2');
}`;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  jobTitle: person.role,
  email: `mailto:${person.email}`,
  url: site.href,
  sameAs: [person.github, ...(typeof person.linkedin === 'string' ? [person.linkedin] : [])],
  knowsAbout: ['Quality assurance', 'Test automation', 'HL7', 'FHIR', 'Healthcare interoperability'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Theme: follow the system unless the visitor picked one. Runs before paint. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') root.dataset.theme = saved;
        } catch (e) {}
      })();
    </script>

    <meta name="theme-color" content="#f8f7f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1521" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Lisna Thomas, QA Engineer. A terminal shows a passing test run: has 6+ years of QA experience, speaks HL7 and FHIR." />
    <meta property="profile:first_name" content={person.givenName} />
    <meta property="profile:last_name" content={person.familyName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(personLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 700;
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }
</style>
