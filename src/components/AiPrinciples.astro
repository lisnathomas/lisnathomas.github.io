---
import SectionHeading from './SectionHeading.astro';
import { aiPrinciples } from '../data/profile';
---

<section id="ai" class="section" aria-labelledby="ai-title">
  <div class="container">
    <SectionHeading id="ai" index={5} file="ai-guardrails.ts" title="How I use AI in testing">
      <p>
        I was part of the AI Champions group bringing AI into QA at Altera Digital Health. AI helps me test
        faster. These four rules keep it honest.
      </p>
    </SectionHeading>

    <ol class="principles" role="list">
      {
        aiPrinciples.map((p, i) => (
          <li class="principle">
            <p class="principle__rule mono" aria-hidden="true">
              <span class="principle__num">{String(i + 1).padStart(2, '0')}</span>
              guard: {p.rule}
            </p>
            <h3>{p.title}</h3>
            {p.body && <p class="principle__body">{p.body}</p>}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .principles {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }

  @media (min-width: 48rem) {
    .principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }

  .principle {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-5) var(--space-6);
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .principle__rule {
    display: flex;
    gap: var(--space-3);
    color: var(--ink-2);
    font-size: var(--step--1);
  }

  .principle__num {
    color: var(--accent);
    font-weight: 700;
  }

  h3 {
    font-size: var(--step-1);
    line-height: 1.3;
  }

  .principle__body {
    color: var(--ink-2);
  }
</style>
